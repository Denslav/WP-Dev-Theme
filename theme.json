{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "75rem",
      "wideSize": "90rem"
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "color": {
      "background": true,
      "custom": true,
      "customGradient": true,
      "palette": [
        { "slug": "primary", "color": "#272A35", "name": "Primary" },
        { "slug": "success", "color": "#20CBA2", "name": "Success" },
        { "slug": "accent", "color": "#F2F9FF", "name": "Accent" },
        { "slug": "link", "color": "#0076EC", "name": "Link" },
        { "slug": "white", "color": "#FFFFFF", "name": "White" },
        { "slug": "black", "color": "#000000", "name": "Black" }
      ],
      "gradients": [
        {
          "slug": "gradient-blue",
          "gradient": "radial-gradient(59.58% 53.89% at 20.8% 75.39%, #fff 27.25%, rgba(255, 255, 255, 0.35) 48.65%, rgba(255, 255, 255, 0) 100%), radial-gradient(93.75% 36.85% at 31.05% 6.31%, rgba(2, 126, 253, 0.6) 37.5%, rgba(255, 255, 255, 0.35) 70.45%, rgba(255, 255, 255, 0) 100%), radial-gradient(119% 56.83% at 87.26% 8.01%, rgba(2, 126, 253, 0.6) 29.65%, rgba(255, 255, 255, 0) 100%), radial-gradient(216.14% 87.74% at 67.01% 30.78%, #fff 73.32%, #47ddff 100%)",
          "name": "Gradient Blue"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "fontSizes": [
        { "slug": "h1", "size": "2.5rem", "name": "H1" },
        { "slug": "h2", "size": "1.875rem", "name": "H2" },
        { "slug": "h3", "size": "1.5rem", "name": "H3" },
        { "slug": "h4", "size": "1.125rem", "name": "H4" },
        { "slug": "h5", "size": "1rem", "name": "H5" },
        { "slug": "h6", "size": "0.875rem", "name": "H6" },
        { "slug": "large", "size": "1.125rem", "name": "Text Large" },
        { "slug": "normal", "size": "1rem", "name": "Text Normal" },
        { "slug": "medium", "size": "0.875rem", "name": "Text Medium" },
        { "slug": "small", "size": "0.75rem", "name": "Text Small" }
      ],
      "fontFamilies": [
        { "slug": "heading", "fontFamily": "Lato, Arial, sans-serif", "name": "Lato" },
        { "slug": "body", "fontFamily": "Roboto, Arial, sans-serif", "name": "Roboto" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#FFFFFF",
      "text": "#272A35"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "#272A35"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "#0076EC"
        }
      }
    }
  }
}
